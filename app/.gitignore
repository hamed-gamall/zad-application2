# ---------- Node / npm ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Next.js ----------
.next/
out/
build/
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------- Testing / coverage ----------
coverage/

# ---------- Env / secrets ----------
.env
.env*.local
.env.development
.env.production

# ---------- Editor / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- Vercel ----------
.vercel

# ================= Android / Capacitor (android/) =================

# Gradle
android/.gradle/
android/build/
android/app/build/
android/*/build/
android/captures/
android/.cxx/

# Local machine-specific config — contains the absolute path to your
# Android SDK install, different on every machine, never shared.
android/local.properties

# Android Studio
android/.idea/
android/*.iml
android/*/*.iml

# Signing keys — never commit a real keystore or its passwords.
android/*.keystore
android/*.jks
android/key.properties

# Build outputs
android/app/release/
*.apk
*.aab

# Capacitor auto-generated native config snapshot (regenerated by
# `npx cap sync` from capacitor.config.ts — no need to track it twice).
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
