{"number": 75, "nameArabic": "al-Qiyamah", "titleArabic": "القيامة", "titleEnglish": "The Resurrection", "titleTranslit": "Al-Qiyamah", "revelationPlace": "Mecca", "revelationType": "Makkiyah", "ayahCount": 40, "verses": [{"ayah": 0, "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"}, {"ayah": 1, "text": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ"}, {"ayah": 2, "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"}, {"ayah": 3, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"}, {"ayah": 4, "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"}, {"ayah": 5, "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ"}, {"ayah": 6, "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ"}, {"ayah": 7, "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ"}, {"ayah": 8, "text": "وَخَسَفَ ٱلْقَمَرُ"}, {"ayah": 9, "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"}, {"ayah": 10, "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"}, {"ayah": 11, "text": "كَلَّا لَا وَزَرَ"}, {"ayah": 12, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"}, {"ayah": 13, "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"}, {"ayah": 14, "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ"}, {"ayah": 15, "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"}, {"ayah": 16, "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"}, {"ayah": 17, "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"}, {"ayah": 18, "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"}, {"ayah": 19, "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}, {"ayah": 20, "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"}, {"ayah": 21, "text": "وَتَذَرُونَ ٱلْءَاخِرَةَ"}, {"ayah": 22, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ"}, {"ayah": 23, "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ"}, {"ayah": 24, "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ"}, {"ayah": 25, "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ"}, {"ayah": 26, "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"}, {"ayah": 27, "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ"}, {"ayah": 28, "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"}, {"ayah": 29, "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"}, {"ayah": 30, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"}, {"ayah": 31, "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"}, {"ayah": 32, "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"}, {"ayah": 33, "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"}, {"ayah": 34, "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"}, {"ayah": 35, "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"}, {"ayah": 36, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى"}, {"ayah": 37, "text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ"}, {"ayah": 38, "text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ"}, {"ayah": 39, "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"}, {"ayah": 40, "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ"}], "source": "Mohamed-Nagdy/Quran-App-Data"}