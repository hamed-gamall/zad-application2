{"number": 77, "nameArabic": "al-Mursalat", "titleArabic": "المرسلات", "titleEnglish": "The Emissaries", "titleTranslit": "Al-Mursalat", "revelationPlace": "Mecca", "revelationType": "Makkiyah", "ayahCount": 50, "verses": [{"ayah": 0, "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"}, {"ayah": 1, "text": "وَٱلْمُرْسَلَٰتِ عُرْفًۭا"}, {"ayah": 2, "text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا"}, {"ayah": 3, "text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا"}, {"ayah": 4, "text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا"}, {"ayah": 5, "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا"}, {"ayah": 6, "text": "عُذْرًا أَوْ نُذْرًا"}, {"ayah": 7, "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ"}, {"ayah": 8, "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"}, {"ayah": 9, "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"}, {"ayah": 10, "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"}, {"ayah": 11, "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"}, {"ayah": 12, "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ"}, {"ayah": 13, "text": "لِيَوْمِ ٱلْفَصْلِ"}, {"ayah": 14, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"}, {"ayah": 15, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 16, "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"}, {"ayah": 17, "text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ"}, {"ayah": 18, "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"}, {"ayah": 19, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 20, "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ"}, {"ayah": 21, "text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ"}, {"ayah": 22, "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ"}, {"ayah": 23, "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"}, {"ayah": 24, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 25, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"}, {"ayah": 26, "text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا"}, {"ayah": 27, "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا"}, {"ayah": 28, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 29, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"ayah": 30, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ"}, {"ayah": 31, "text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"}, {"ayah": 32, "text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ"}, {"ayah": 33, "text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ"}, {"ayah": 34, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 35, "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ"}, {"ayah": 36, "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"}, {"ayah": 37, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 38, "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ"}, {"ayah": 39, "text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ"}, {"ayah": 40, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 41, "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ"}, {"ayah": 42, "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"}, {"ayah": 43, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"}, {"ayah": 44, "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"ayah": 45, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 46, "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"}, {"ayah": 47, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 48, "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"}, {"ayah": 49, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"}, {"ayah": 50, "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}], "source": "Mohamed-Nagdy/Quran-App-Data"}